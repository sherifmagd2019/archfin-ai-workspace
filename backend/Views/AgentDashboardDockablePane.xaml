<UserControl x:Class="ArchFinAI.Backend.Views.AgentDashboardDockablePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="360"
             Background="#181825" Foreground="#CDD6F4"
             FontFamily="Segoe UI, Helvetica, Arial">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="ArchFin Agent" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" DockPanel.Dock="Left"/>
                    <Border DockPanel.Dock="Right" Background="#313244" CornerRadius="12" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#A6E3A1" Margin="0,0,6,0"/>
                            <TextBlock Text="PORT 8080" FontSize="10" FontWeight="SemiBold" Foreground="#A6E3A1"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <TextBlock Text="Revit 2027 BIM MPT Live Stream" FontSize="11" Foreground="#A6ADC8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Live Allocation Metrics Card -->
        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="ALLOCATION WEIGHT MATRIX" FontSize="11" FontWeight="Bold" Foreground="#BAC2DE" Margin="0,0,0,10"/>
                
                <!-- Residential Bar -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Residential" FontSize="12" Foreground="#89B4FA" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" x:Name="PbResidential" Height="10" Value="33.3" Maximum="100" 
                                 Foreground="#89B4FA" Background="#313244" Margin="4,0" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" x:Name="TxtResVal" Text="33.3%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Commercial Bar -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Commercial" FontSize="12" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" x:Name="PbCommercial" Height="10" Value="33.3" Maximum="100" 
                                 Foreground="#F9E2AF" Background="#313244" Margin="4,0" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" x:Name="TxtCommVal" Text="33.3%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Industrial Bar -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Industrial" FontSize="12" Foreground="#F38BA8" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" x:Name="PbIndustrial" Height="10" Value="33.4" Maximum="100" 
                                 Foreground="#F38BA8" Background="#313244" Margin="4,0" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" x:Name="TxtIndVal" Text="33.4%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Live Agent Telemetry & Log Console -->
        <Border Grid.Row="2" Background="#11111B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="AGENT TELEMETRY CONSOLE" FontSize="10" FontWeight="Bold" Foreground="#6C7086" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#A6ADC8" 
                             BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True"
                             FontFamily="Consolas, JetBrains Mono, Courier New" FontSize="11"
                             Text="[ArchFin Agent] Listening on http://localhost:8080/revit-sync/&#x0a;[Revit] ExternalEvent handler initialized&#x0a;[Status] Ready for React MPT payloads..."/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Action Footer -->
        <StackPanel Grid.Row="3">
            <Button x:Name="BtnOpenDashboard" Content="Launch Web Dashboard" 
                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" 
                    Padding="10,8" Margin="0,0,0,6" Click="BtnOpenDashboard_Click"
                    BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnApplyToCanvas" Content="Force Revit Canvas Recalculation" 
                    Background="#313244" Foreground="#CDD6F4" 
                    Padding="8,6" Click="BtnApplyToCanvas_Click"
                    BorderThickness="1" BorderBrush="#45475A" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
